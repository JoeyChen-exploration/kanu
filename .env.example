# 复制成 .env 再填；.env 不进 git

# ---- Discord 应用（Developer Portal → 你的应用 → OAuth2）----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token（M0 用不到，开包播报和私信时才要）
DISCORD_BOT_TOKEN=
# 只允许这个服务器的成员进入；开发时填你自己的测试服务器，留空则不检查
GUILD_ID=
ANNOUNCE_CHANNEL_ID=
ADMIN_ALERT_CHANNEL_ID=
ADMIN_USER_IDS=
ADMIN_ROLE_ID=

# ---- 服务器 ----
PORT=4790
HOST=127.0.0.1
# 会话签名密钥，生产必须填一个长随机串；本机开 DEV_AUTH=1 时可以留空
SESSION_SECRET=
DB_PATH=./data/kanu.sqlite
KANU_DISABLED=0

# ---- 本机开发 ----
# 1 = 普通浏览器里可以不经过 Discord 直接登录（生产不要开）
DEV_AUTH=1

# ---- 旺财钱包 ----
# mock = 本机假余额（不碰任何真钱包）；live = 调旺财 control-server
WALLET_MODE=mock
DEV_WALLET_COINS=500
# live 时填，和旺财 .env 里的 CONTROL_PORT / CONTROL_SECRET 一致
WANGCAI_CONTROL_PORT=
WANGCAI_CONTROL_SECRET=
