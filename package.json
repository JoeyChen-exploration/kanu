{
  "name": "kanu",
  "private": true,
  "type": "module",
  "description": "卡奴：Discord Activity 卡牌经营游戏",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @kanu/server\" \"npm run dev -w @kanu/client\"",
    "tunnel": "node scripts/tunnel.mjs",
    "build": "npm run build -w @kanu/client",
    "start": "npm run start -w @kanu/server",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client",
    "sim": "tsx scripts/sim.ts",
    "sim:collect": "tsx scripts/collect-sim.ts",
    "shots": "node scripts/shots.cjs",
    "art:check": "tsx scripts/art-check.ts",
    "art:build": "node scripts/art/build.mjs",
    "art:import": "node scripts/art/import.mjs"
  },
  "devDependencies": {
    "@fontsource/unbounded": "^5.3.0",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
